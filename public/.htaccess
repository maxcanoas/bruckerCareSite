# BruckerCare: configuração para a hospedagem HostGator (Apache).
# O Cloudflare fica na frente: use o modo SSL "Full" (não "Flexible"),
# senão o redirecionamento para HTTPS abaixo entra em laço.

Options -MultiViews -Indexes
RewriteEngine On

# HTTPS e sem www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://bruckercare.com.br%{REQUEST_URI} [L,R=301]

# /pagina.html e /index.html viram o endereço limpo
RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]
RewriteRule ^index$ / [L,R=301]
RewriteCond %{THE_REQUEST} \s/+([^.?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# Barra no fim: /quem-somos/ vira /quem-somos
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [L,R=301]

# /quem-somos é servido a partir de quem-somos.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

ErrorDocument 404 /404.html

# Cache: arquivos com hash no nome (pasta _astro) por 1 ano; páginas sempre conferidas.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

AddType image/avif .avif
AddType font/woff2 .woff2
