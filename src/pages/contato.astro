---
// Contato: contatos diretos à esquerda e, à direita, o formulário que monta a
// mensagem e abre o WhatsApp da BruckerCare. Nada é enviado ao servidor.
// Sem JavaScript, o formulário manda só o campo de mensagem para o WhatsApp.
import BaseLayout from "../layouts/BaseLayout.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import WhatsAppIcon from "../components/icons/WhatsAppIcon.astro";
import { company } from "../data/empresa";
import { breadcrumbSchema } from "../lib/schema";
---

<BaseLayout
  schema={[breadcrumbSchema("Contato", "/contato")]}
  title="Contato | BruckerCare, aluguel de poltrona pós-operatório"
  description="Fale com a BruckerCare pelo WhatsApp (51) 99863-1666 e consulte a disponibilidade da poltrona. Entrega e retirada em casa em Canoas, Porto Alegre e região."
>
  <section class="contact tone-paper" aria-labelledby="contact-title">
    <div class="grid contact__grid">
      <div class="contact__direct">
        <span class="label">contato</span>
        <h1 id="contact-title" class="contact__title heading">Fale com <em>a {company.name}</em></h1>
        <p class="contact__lead t-lead">Tire as suas dúvidas e consulte a disponibilidade da poltrona. O atendimento é pelo WhatsApp.</p>
        <WhatsAppButton class="contact__cta" placement="contactDirect" label="Chamar no WhatsApp" />

        <dl class="contact__list">
          <div>
            <dt>Telefone</dt>
            <dd><a href={company.phone.href} data-track="phone">{company.phone.display}</a></dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
          <div>
            <dt>Instagram</dt>
            <dd>
              <a href={company.instagram.url} target="_blank" rel="noopener" data-track="instagram">
                {company.instagram.handle}<span class="sr-only"> (abre em nova aba)</span>
              </a>
            </dd>
          </div>
          <div>
            <dt>Área de atendimento</dt>
            <dd>{company.serviceArea}, com entrega e retirada em casa.</dd>
          </div>
          <div>
            <dt>Horário</dt>
            <dd>{company.hours}</dd>
          </div>
        </dl>
      </div>

      <div class="contact__panel">
        <h2 class="t-h3" id="form-title">Mande a sua mensagem</h2>
        <p class="contact__form-intro">
          Preencha e toque em enviar: o WhatsApp abre com a mensagem pronta, e você confere antes de mandar.
        </p>

        <form
          class="contact__form"
          action={`https://wa.me/${company.whatsapp.number}`}
          method="get"
          target="_blank"
          aria-labelledby="form-title"
          data-whatsapp-form
        >
          <div class="field js-only">
            <label for="contato-nome">Seu nome</label>
            <input id="contato-nome" type="text" autocomplete="name" data-field="nome" />
          </div>
          <div class="field js-only">
            <label for="contato-cidade">Cidade</label>
            <input id="contato-cidade" type="text" autocomplete="address-level2" data-field="cidade" />
          </div>
          <div class="field js-only">
            <label for="contato-data">Quando você precisa da poltrona</label>
            <input id="contato-data" type="date" data-field="data" />
          </div>
          <div class="field">
            <label for="contato-mensagem">Mensagem</label>
            <textarea id="contato-mensagem" name="text" rows="5" aria-describedby="contato-mensagem-dica" data-field="mensagem"></textarea>
            <p class="field__hint" id="contato-mensagem-dica">Não é preciso contar detalhes do procedimento.</p>
          </div>

          <button class="btn contact__submit" type="submit">
            <WhatsAppIcon class="btn__icon" />
            <span>Enviar pelo WhatsApp</span><span class="sr-only"> (abre o WhatsApp em nova aba)</span>
          </button>
          <p class="contact__privacy t-small">
            Nada fica guardado no site. A mensagem vai direto para o WhatsApp da {company.name}.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: calc(var(--header-h) + 56px) 120px;
  }

  .contact__title {
    margin-top: 22px;
    font-size: clamp(2.25rem, 1.6rem + 2.8vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.038em;
  }

  .contact__lead {
    max-width: 36ch;
    margin-top: 18px;
    color: var(--fg-soft);
  }

  .contact__direct :global(.contact__cta) {
    margin-top: 30px;
  }

  .contact__list {
    margin: 48px 0 0;
    border-top: 1px solid var(--line);
  }

  .contact__list > div {
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }

  .contact__list dt {
    color: var(--accent);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .contact__list dd {
    margin: 4px 0 0;
    font-weight: 450;
  }

  .contact__list a {
    color: var(--heading);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* ---------- Formulário ---------- */

  .contact__panel {
    margin-top: 56px;
    padding: 32px 22px 36px;
    border-radius: var(--r-l);
    background: var(--c-linen);
  }

  .contact__form-intro {
    margin-top: 8px;
    color: var(--fg-soft);
  }

  .contact__form {
    display: grid;
    gap: 20px;
    margin-top: 28px;
  }

  .field label {
    display: block;
    margin-bottom: 8px;
    color: var(--heading);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: 52px;
    padding: 13px 16px;
    border: 1px solid rgb(8 43 39 / 0.3);
    border-radius: 14px;
    background: var(--c-shell);
    color: var(--c-ink);
    font: inherit;
    transition:
      border-color var(--t-fast) var(--ease),
      box-shadow var(--t-fast) var(--ease);
  }

  .field textarea {
    resize: vertical;
  }

  .field input:hover,
  .field textarea:hover {
    border-color: var(--c-brand);
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 2px solid var(--c-tobacco);
    outline-offset: 2px;
    border-color: var(--c-brand);
  }

  .field__hint {
    margin-top: 8px;
    color: var(--fg-soft);
    font-size: var(--fs-small);
  }

  /* Nome, cidade e data só fazem sentido com JavaScript, que junta tudo na mensagem. */
  .js-only {
    display: none;
  }

  :global(.js) .js-only {
    display: block;
  }

  .contact__submit {
    justify-self: start;
    margin-top: 8px;
  }

  .contact__privacy {
    color: var(--fg-soft);
  }

  @media (min-width: 768px) {
    .contact__panel {
      padding: 40px;
    }

    .contact__form {
      grid-template-columns: 1fr 1fr;
    }

    .contact__form .field:nth-child(3),
    .contact__form .field:nth-child(4),
    .contact__submit,
    .contact__privacy {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .contact {
      padding-block: calc(var(--header-h) + 96px) 168px;
    }

    .contact__direct {
      grid-column: col 1 / span 5;
    }

    .contact__panel {
      grid-column: col 7 / span 6;
      grid-row: 1;
      align-self: start;
      margin-top: 0;
      padding: 48px;
    }
  }
</style>

<script>
  // Junta os campos numa mensagem só e abre o WhatsApp com ela.
  // A mensagem vai pelo campo "text" do link wa.me; nada passa pelo servidor do site.
  const form = document.querySelector<HTMLFormElement>("[data-whatsapp-form]");
  if (form) {
    const value = (field: string) =>
      form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-field="${field}"]`)?.value.trim() ?? "";
    const name = form.querySelector<HTMLInputElement>('[data-field="nome"]');
    const date = form.querySelector<HTMLInputElement>('[data-field="data"]');
    const message = form.querySelector<HTMLTextAreaElement>('[data-field="mensagem"]');

    // Com JavaScript, o texto final vai num campo escondido.
    const text = document.createElement("input");
    text.type = "hidden";
    text.name = "text";
    message?.removeAttribute("name");
    form.append(text);
    if (name) name.required = true;
    if (date) {
      // Data de hoje no fuso de quem está usando (toISOString usaria o UTC).
      const today = new Date();
      today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
      date.min = today.toISOString().slice(0, 10);
    }

    form.addEventListener("submit", () => {
      const when = value("data") ? value("data").split("-").reverse().join("/") : "";
      text.value = [
        "Olá! Vim pelo site da BruckerCare.",
        value("nome") && `Nome: ${value("nome")}`,
        value("cidade") && `Cidade: ${value("cidade")}`,
        when && `Preciso da poltrona a partir de: ${when}`,
        value("mensagem"),
      ]
        .filter(Boolean)
        .join("\n");
    });
  }
</script>
