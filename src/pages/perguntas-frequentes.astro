---
// Perguntas frequentes: grupos em <details>, com o título e o índice presos à
// esquerda no desktop.
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqItems from "../components/FaqItems.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { questionGroups, questions } from "../data/perguntas";
import { breadcrumbSchema, faqSchema } from "../lib/schema";
---

<BaseLayout
  schema={[breadcrumbSchema("Perguntas frequentes", "/perguntas-frequentes"), faqSchema(questions)]}
  title="Dúvidas sobre aluguel de poltrona pós-operatório | BruckerCare"
  description="Período mínimo, entrega, cidades atendidas, higienização e pagamento: as dúvidas mais comuns sobre a locação de poltrona reclinável para o pós-operatório."
>
  <section class="faq-page tone-paper" aria-labelledby="faq-page-title">
    <div class="grid faq-page__grid">
      <aside class="faq-page__aside">
        <span class="label">perguntas frequentes</span>
        <h1 id="faq-page-title" class="faq-page__title heading">Dúvidas sobre <em>o aluguel da poltrona</em></h1>
        <p class="faq-page__lead">As respostas para o que mais perguntam antes de alugar a poltrona.</p>

        <nav class="faq-page__nav" aria-label="Grupos de perguntas">
          <ul class="faq-page__nav-list">
            {questionGroups.map((group) => <li><a href={`#${group.id}`}>{group.title}</a></li>)}
          </ul>
        </nav>

        <div class="faq-page__ask">
          <p>Ficou alguma dúvida?</p>
          <WhatsAppButton placement="faqAside" label="Perguntar no WhatsApp" size="small" />
        </div>
      </aside>

      <div class="faq-page__groups">
        {
          questionGroups.map((group) => (
            <section class="faq-page__group" id={group.id} aria-labelledby={`${group.id}-title`}>
              <h2 id={`${group.id}-title`} class="label faq-page__group-title">{group.title.toLowerCase()}</h2>
              <FaqItems questions={group.questions} group={`faq-${group.id}`} anchors />
            </section>
          ))
        }

        <div class="faq-page__end tone-dark">
          <h2 class="t-h3">Não encontrou a sua dúvida?</h2>
          <p>Mande a sua pergunta pelo WhatsApp. A resposta vem da própria BruckerCare.</p>
          <WhatsAppButton placement="faqEnd" label="Perguntar no WhatsApp" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-page {
    padding-block: calc(var(--header-h) + 56px) 120px;
  }

  .faq-page__title {
    margin-top: 22px;
    font-size: clamp(2.25rem, 1.6rem + 2.8vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.038em;
  }

  .faq-page__lead {
    max-width: 36ch;
    margin-top: 18px;
    color: var(--fg-soft);
  }

  .faq-page__nav {
    margin-top: 28px;
  }

  .faq-page__nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Índice em pílulas finas */
  .faq-page__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--heading);
    font-size: 0.9375rem;
    font-weight: 450;
    text-decoration: none;
    transition:
      border-color var(--t-fast) var(--ease),
      background-color var(--t-fast) var(--ease);
  }

  .faq-page__nav a:hover {
    border-color: var(--heading);
    background: var(--c-shell);
  }

  .faq-page__ask {
    display: none;
  }

  .faq-page__groups {
    margin-top: 56px;
  }

  .faq-page__group {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .faq-page__group + .faq-page__group {
    margin-top: 64px;
  }

  .faq-page__group-title {
    margin-bottom: 14px;
  }

  .faq-page__end {
    margin-top: 72px;
    padding: 32px 26px 36px;
    border-radius: var(--r-l);
  }

  .faq-page__end > * + * {
    margin-top: 12px;
  }

  .faq-page__end h2 {
    color: var(--c-cream);
  }

  .faq-page__end p {
    max-width: 44ch;
    color: var(--fg-soft);
  }

  .faq-page__end :global(.btn) {
    margin-top: 24px;
  }

  @media (min-width: 1024px) {
    .faq-page {
      padding-block: calc(var(--header-h) + 96px) 168px;
    }

    .faq-page__aside {
      grid-column: col 1 / span 4;
      grid-row: 1;
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + 48px);
    }

    .faq-page__nav-list {
      display: grid;
      justify-items: start;
    }

    .faq-page__ask {
      display: block;
      margin-top: 40px;
      padding-top: 24px;
      border-top: 1px solid var(--line);
      color: var(--fg-soft);
    }

    .faq-page__ask :global(.btn) {
      margin-top: 16px;
    }

    .faq-page__groups {
      grid-column: col 6 / span 7;
      grid-row: 1;
      margin-top: 0;
    }

    .faq-page__end {
      padding: 48px;
    }
  }
</style>
