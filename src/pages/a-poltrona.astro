---
// A poltrona (posts 3, 7, 8 e 12). Abertura no verde com a foto de estúdio,
// a narrativa das funções no papel, a locação em 6 passos no linho, o processo
// com a etiqueta e o fechamento.
import BaseLayout from "../layouts/BaseLayout.astro";
import Frame from "../components/Frame.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import ChairStory from "../components/sections/ChairStory.astro";
import Process from "../components/sections/Process.astro";
import Closing from "../components/sections/Closing.astro";
import { company } from "../data/empresa";
import { rentalSteps } from "../data/locacao";
import { chairPhotos } from "../data/poltrona";
import { breadcrumbSchema, serviceSchema } from "../lib/schema";
---

<BaseLayout
  schema={[serviceSchema(), breadcrumbSchema("A poltrona", "/a-poltrona")]}
  title="Poltrona reclinável elétrica para pós-operatório | BruckerCare"
  description="Poltrona reclinável elétrica para alugar no pós-operatório, com apoio para as pernas e controle. Entrega e retirada em Canoas, Porto Alegre e região."
>
  <section class="chair-hero tone-dark" aria-labelledby="chair-title">
    <div class="grid chair-hero__grid">
      <div class="chair-hero__text">
        <span class="label">a poltrona</span>
        <h1 id="chair-title" class="chair-hero__title heading">
          Poltrona reclinável elétrica para <em>a recuperação em casa</em>.
        </h1>
        <p class="chair-hero__lead">
          Reclinação eletrônica, apoio para as pernas e ajuste com um toque no controle. Para a recuperação pós-cirúrgica,
          com entrega e retirada em {company.serviceArea}.
        </p>
        <WhatsAppButton class="chair-hero__cta" placement="chairIntro" label="Consultar disponibilidade" />
      </div>
      <Frame
        class="chair-hero__photo"
        name={chairPhotos.studio.name}
        alt={chairPhotos.studio.alt}
        widths={[480, 720, 928]}
        sizes="(min-width: 1024px) 40vw, 92vw"
        ratio="4 / 5"
        priority
      />
    </div>
  </section>

  <ChairStory
    tone="paper"
    sheet
    label="as funções"
    titleHtml="Como ela <em>se ajusta a você</em>"
    steps={[
      {
        photo: chairPhotos.room,
        short: "em casa",
        pos: "64% 50%",
        title: "Como ela se ajusta a você",
        text: "A poltrona foi pensada para oferecer mais praticidade e conforto no período de recuperação, facilitando os momentos do dia a dia que podem exigir mais do corpo.",
      },
      {
        photo: chairPhotos.reclined,
        short: "reclinação",
        title: "Reclinação eletrônica e apoio para as pernas",
        text: "O encosto reclina e o apoio para as pernas se estende pelo comando elétrico, de forma simples e confortável. Você descansa na posição que preferir, com as pernas apoiadas.",
      },
      {
        photo: chairPhotos.remote,
        short: "controle",
        title: "Um toque no controle",
        text: "Com apenas um toque no controle, você encontra a posição ideal. O controle tem fio, então fica sempre ao alcance.",
      },
      {
        photo: chairPhotos.armButtons,
        short: "botões",
        title: "Botões no braço",
        text: "Na lateral do braço, um painel com dois botões também ajusta a posição, sem precisar procurar o controle.",
      },
    ]}
    motto="Cuidado, conforto e autonomia para você."
  />

  <section class="rental tone-linen sheet" aria-labelledby="rental-title">
    <div class="grid rental__grid">
      <div class="rental__head">
        <span class="label">como funciona</span>
        <h2 id="rental-title" class="heading t-h2">Como funciona <em>o aluguel</em></h2>
        <p>Do primeiro contato à retirada, você tem suporte durante toda a locação.</p>
      </div>

      <ol class="rental__list">
        {
          rentalSteps.map((step, i) => (
            <li class="rental__item" data-reveal="rise" style={`--d:${i % 3}`}>
              <span class="num rental__num">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="t-h3">{step.title}</h3>
              <p>
                {step.text}
                {step.closing && <strong> {step.closing}</strong>}
              </p>
            </li>
          ))
        }
      </ol>

      <div class="rental__cta">
        <WhatsAppButton placement="chairRental" label="Consultar disponibilidade" />
      </div>
    </div>
  </section>

  <Process />

  <Closing placement="chairClosing" />
</BaseLayout>

<style>
  /* ---------- Abertura no verde ---------- */

  .chair-hero {
    padding-block: calc(var(--header-h) + 36px) 88px;
  }

  .chair-hero__text > * + * {
    margin-top: 20px;
  }

  .chair-hero__title {
    margin-top: 22px;
    font-size: clamp(2.25rem, 1.6rem + 2.9vw, 4.25rem);
    line-height: 1.04;
    letter-spacing: -0.038em;
  }

  .chair-hero__lead {
    max-width: 40ch;
    color: var(--fg-soft);
  }

  .chair-hero__text :global(.chair-hero__cta) {
    margin-top: 32px;
  }

  .chair-hero :global(.chair-hero__photo) {
    margin-top: 48px;
  }

  @media (min-width: 768px) {
    .chair-hero :global(.chair-hero__photo) {
      width: min(100%, 520px);
    }
  }

  @media (min-width: 1024px) {
    .chair-hero {
      display: flex;
      align-items: center;
      min-height: min(100svh, 980px);
      padding-block: calc(var(--header-h) + 32px) 72px;
    }

    .chair-hero__grid {
      flex: 1;
      align-items: center;
    }

    .chair-hero__text {
      grid-column: col 1 / span 6;
      grid-row: 1;
    }

    .chair-hero :global(.chair-hero__photo) {
      grid-column: col 8 / span 5;
      grid-row: 1;
      justify-self: end;
      width: min(100%, calc(min(74svh, 760px) * 0.8));
      margin-top: 0;
    }
  }

  /* ---------- Locação em 6 passos ---------- */

  .rental {
    padding-block: 104px 120px;
  }

  .rental__head > * + * {
    margin-top: 18px;
  }

  .rental__head .heading {
    margin-top: 20px;
  }

  .rental__head p {
    max-width: 40ch;
    color: var(--fg-soft);
  }

  .rental__list {
    display: grid;
    gap: 16px;
    margin-top: 44px;
  }

  .rental__item {
    padding: 26px 24px 28px;
    border-radius: var(--r-l);
    background: var(--c-shell);
    box-shadow: inset 0 0 0 1px rgb(8 43 39 / 0.07);
  }

  .rental__item > * + * {
    margin-top: 10px;
  }

  .rental__num {
    margin-bottom: 16px;
    font-size: 2.5rem;
  }

  .rental__item p {
    max-width: 48ch;
    color: var(--fg-soft);
  }

  .rental__item strong {
    font-weight: 500;
    color: var(--c-brand);
  }

  .rental__cta {
    margin-top: 40px;
  }

  @media (min-width: 768px) {
    .rental__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gutter);
    }
  }

  @media (min-width: 1024px) {
    .rental {
      padding-block: 160px 176px;
    }

    .rental__head {
      grid-column: col 1 / span 6;
    }

    .rental__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 64px;
    }

    .rental__item {
      padding: 36px 32px 40px;
    }

    .rental__cta {
      margin-top: 56px;
    }
  }
</style>
