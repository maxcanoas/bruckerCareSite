---
import "../styles/global.css";
import { Font } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { businessSchema } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  /** Home: o botão flutuante só aparece depois do hero, que já tem o botão. */
  home?: boolean;
  /** Dados estruturados extras desta página (a empresa entra em todas). */
  schema?: Record<string, unknown>[];
  /** Página que não deve aparecer na busca (404). */
  noindex?: boolean;
}

const { title, description, home = false, schema = [], noindex = false } = Astro.props;
// Endereço limpo: /a-poltrona.html → /a-poltrona, /index.html → /.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?(\.html)?\/?$/, "") || "/", Astro.site);
const ogImage = new URL("/og-image.jpg", Astro.site);
const structuredData = [businessSchema(), ...schema];

// GA4 e aviso de cookies só existem com o ID configurado (.env). Na prévia
// (npm run build:preview) o aviso aparece mesmo sem ID, para conferir o visual.
const gaId = import.meta.env.PUBLIC_GA4_ID ?? "";
const showConsent = Boolean(gaId) || process.env.ALLOW_PLACEHOLDERS === "1";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="BruckerCare" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Poltrona elétrica de couro caramelo ao lado do logo da BruckerCare, sobre fundo verde." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f8f5f0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline define:vars={{ consent: showConsent }}>
      // Antes da primeira pintura: marca que há JavaScript, se o aparelho é fraco
      // (economia de dados, ou até 4 núcleos e até 4 GB, para desligar o parallax)
      // e se o aviso de cookies precisa aparecer (sem escolha salva nos últimos 12 meses).
      (function (root, nav) {
        root.classList.add("js");
        var conn = nav.connection;
        var weak = (nav.hardwareConcurrency || 8) <= 4 && (nav.deviceMemory || 8) <= 4;
        if ((conn && conn.saveData) || weak) root.classList.add("lite");
        if (!consent) return;
        var pending = true;
        try {
          var saved = JSON.parse(localStorage.getItem("bruckercare-consent"));
          pending = !(saved && (saved.choice === "granted" || saved.choice === "denied") && Date.now() - saved.at < 31536000000);
        } catch (e) {}
        if (pending) root.classList.add("consent-pending");
      })(document.documentElement, navigator);
    </script>
    {structuredData.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    {showConsent && <CookieConsent gaId={gaId} />}
    <SiteHeader />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <SiteFooter cookiePreferences={showConsent} />
    <WhatsAppFloat deferred={home} />
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
