---
// A etiqueta kraft "higienizada e pronta para você" (post 7): o detalhe que
// costura o site. Pendurada na foto do hero e no fim da costura do processo.
// Feita em HTML e CSS, não é logo. Com `sway`, balança de leve quando aparece
// e com a rolagem (src/scripts/motion.ts); parada sem JS e com movimento reduzido.
interface Props {
  class?: string;
  sway?: boolean;
  /** Ângulo inicial do balanço, em graus, quando a etiqueta aparece. */
  start?: number;
}

const { class: className, sway = false, start = 7 } = Astro.props;
---

<div class:list={["tag", className]} data-sway={sway ? start : undefined}>
  <span class="tag__swing" data-sway-body>
    <span class="tag__card">
      <span class="tag__text">higienizada e pronta para você</span>
    </span>
    <span class="tag__string" aria-hidden="true"></span>
  </span>
</div>

<style>
  .tag {
    --w: 88px; /* largura do cartão */
    --len: 52px; /* barbante até o furo */
    --hole: calc(var(--w) * 0.19); /* centro do furo, a partir do topo do cartão */
    position: absolute;
    z-index: 2;
    width: var(--w);
    pointer-events: none;
  }

  /* O alfinete onde o barbante prende */
  .tag::before {
    content: "";
    position: absolute;
    top: -3px;
    left: 50%;
    z-index: 1;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: #a3835c;
    box-shadow: 0 1px 2px rgb(40 26 10 / 0.35);
  }

  .tag__swing {
    position: relative;
    display: block;
    padding-top: var(--len);
    transform-origin: 50% 0;
    rotate: -2deg;
    filter: drop-shadow(0 8px 10px rgb(48 32 12 / 0.16)) drop-shadow(0 1px 2px rgb(48 32 12 / 0.14));
  }

  .tag__string {
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: calc(var(--len) + var(--hole));
    margin-left: -0.5px;
    background: #9a7e5c;
  }

  /* O cartão: cantos de cima chanfrados, furo com reforço e papel kraft */
  .tag__card {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: var(--w);
    aspect-ratio: 5 / 7;
    padding: 0 11px 12px;
    background:
      linear-gradient(168deg, rgb(255 250 240 / 0.22), rgb(255 250 240 / 0) 42%),
      linear-gradient(0deg, rgb(92 60 22 / 0.1), rgb(92 60 22 / 0) 30%),
      var(--c-kraft);
    color: var(--c-ink);
    clip-path: polygon(26% 0, 74% 0, 100% 14%, 100% 100%, 0 100%, 0 14%);
    -webkit-mask: radial-gradient(circle at 50% var(--hole), transparent 4px, #000 4.5px);
    mask: radial-gradient(circle at 50% var(--hole), transparent 4px, #000 4.5px);
  }

  /* Reforço de papel em volta do furo */
  .tag__card::before {
    content: "";
    position: absolute;
    top: calc(var(--hole) - 8px);
    left: 50%;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    border-radius: 50%;
    background: #d8bb92;
  }

  .tag__text {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: 0.005em;
  }

  @media (min-width: 1024px) {
    .tag {
      --w: 104px;
      --len: 64px;
    }

    .tag__text {
      font-size: 0.8125rem;
    }

    .tag__card {
      padding: 0 13px 14px;
    }
  }
</style>
