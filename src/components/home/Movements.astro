---
// Movimentos (post 4). Verde profundo, só tipografia, abre o capítulo da poltrona.
// Com movimento, o palco fica preso na tela e cada palavra acende e ganha peso
// conforme a rolagem, como quem encontra apoio. Sem movimento (ou sem JS), todas
// as palavras aparecem acesas e a seção rola normalmente.
const words = ["Sentar.", "Levantar.", "Deitar."];
---

<section class="moves tone-dark sheet" data-range="contain" aria-labelledby="moves-title">
  <div class="moves__stage">
    <div class="grid moves__grid">
      <h2 id="moves-title" class="moves__intro">
        Depois de uma cirurgia, movimentos simples podem exigir mais esforço.
      </h2>
      <p class="moves__words">
        {words.map((word, i) => <span class="moves__word" style={`--i:${i}`}>{word}</span>)}
        <span class="moves__word moves__word--last" style="--i:3">Encontrar uma posição confortável.</span>
      </p>
      <p class="moves__answer">
        Recuperação não é sobre ter pressa. <em>É sobre ter suporte.</em>
      </p>
    </div>
  </div>
</section>

<style>
  .moves {
    --slots: 4;
    padding-block: 112px 120px;
  }

  .moves__intro {
    max-width: 30ch;
    color: var(--c-mist);
    font-size: var(--fs-lead);
    font-weight: 400;
    line-height: 1.5;
  }

  .moves__words {
    margin-top: 36px;
    font-size: min(19vw, 15svh, 10.5rem);
    font-weight: 250;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .moves__word {
    display: block;
    color: var(--c-cream);
  }

  .moves__word--last {
    max-width: 13ch;
    margin-top: 0.34em;
    font-size: 0.34em;
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--c-caramel);
  }

  .moves__answer {
    max-width: 30ch;
    margin-top: 48px;
    color: var(--c-mist);
    font-size: var(--fs-lead);
    line-height: 1.5;
  }

  .moves__answer em {
    font-style: normal;
    color: var(--c-cream);
    font-weight: 500;
  }

  @media (min-width: 1024px) {
    .moves__intro {
      grid-column: col 1 / span 4;
    }

    .moves__words {
      grid-column: col 1 / span 12;
    }

    .moves__word--last {
      max-width: none;
    }

    .moves__answer {
      grid-column: col 9 / span 4;
      margin-top: 8px;
    }
  }

  /* ---------- Movimento: o palco fica preso e as palavras acendem uma a uma ---------- */
  /* Cada palavra ocupa uma faixa do progresso (--p). A atual acende e ganha peso;
     as que já passaram ficam acesas, mais leves; as próximas, apagadas (3:1). */

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .moves {
      height: 270vh;
      padding-block: 0;
    }

    :global(.js) .moves__stage {
      position: sticky;
      top: 0;
      display: flex;
      align-items: center;
      min-height: 100svh;
      padding-block: calc(var(--header-h) + 24px) 40px;
    }

    :global(.js) .moves__grid {
      width: 100%;
    }

    :global(.js) .moves__word {
      --local: calc(var(--p) * var(--slots) * 1.18 - var(--i) - 0.12);
      --on: clamp(0, var(--local) * 4, 1);
      --past: clamp(0, (var(--local) - 1) * 3, 1);
      color: color-mix(in srgb, var(--c-cream) calc(var(--on) * 100%), var(--c-dim));
      font-weight: calc(250 + var(--on) * 170 - var(--past) * 110);
    }

    :global(.js) .moves__word--last {
      --past: 0;
      color: color-mix(in srgb, var(--c-caramel) calc(var(--on) * 100%), var(--c-dim));
      font-weight: calc(300 + var(--on) * 100);
    }

    :global(.js) .moves__answer {
      opacity: clamp(0, (var(--p) - 0.8) * 7, 1);
      translate: 0 calc((1 - clamp(0, (var(--p) - 0.8) * 7, 1)) * 16px);
    }
  }

  @media (prefers-reduced-motion: no-preference) and (max-width: 1023px) {
    :global(.js) .moves {
      height: 230vh;
    }
  }
</style>
