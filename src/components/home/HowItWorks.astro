---
// Como funciona o aluguel (post 12). Linho.
// Os seis passos viram cartões que se empilham: cada um fica preso no alto e o
// seguinte assenta por cima, deixando à mostra a borda dos anteriores.
// No desktop, o título fica preso à esquerda enquanto os cartões passam.
import Frame from "../Frame.astro";
import WhatsAppButton from "../WhatsAppButton.astro";
import { rentalSteps as steps } from "../../data/locacao";
import { chairPhotos } from "../../data/poltrona";

// Fotos que acompanham dois passos: a entrega e o uso em casa.
const photos: Record<number, { name: string; alt: string; pos?: string }> = {
  3: {
    name: "entrega-porta",
    alt: "Dois entregadores de camiseta verde carregam uma poltrona bege protegida por capa até a porta de uma casa, onde uma mulher os recebe.",
  },
  4: { ...chairPhotos.room, pos: "64% 50%" },
};
---

<section class="how tone-linen sheet" aria-labelledby="how-title">
  <div class="grid how__grid">
    <header class="how__head">
      <span class="label">como funciona</span>
      <h2 id="how-title" class="heading t-h2">Como funciona <em>o aluguel</em></h2>
      <p class="how__intro">Do primeiro contato à retirada, você tem suporte durante todo o processo.</p>
      <WhatsAppButton class="how__cta" placement="homeHowItWorks" label="Consultar disponibilidade" />
    </header>

    <ol class="how__cards">
      {
        steps.map((step, i) => (
          <li class:list={["how__card", photos[i] && "how__card--photo"]} style={`--i:${i}`}>
            <div class="how__card-text">
              <span class="num how__num">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="t-h3">{step.title}</h3>
              <p>{step.text}</p>
              {step.closing && <p class="how__closing">{step.closing}</p>}
            </div>
            {photos[i] && (
              <Frame
                class="how__photo"
                name={photos[i].name}
                alt={photos[i].alt}
                widths={[400, 640, 880]}
                sizes="(min-width: 1024px) 24vw, 84vw"
                ratio="3 / 2"
                pos={photos[i].pos}
              />
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    padding-block: 104px 120px;
  }

  .how__head > * + * {
    margin-top: 18px;
  }

  .how__head .heading {
    margin-top: 20px;
  }

  .how__intro {
    max-width: 34ch;
    color: var(--fg-soft);
  }

  .how__head :global(.how__cta) {
    margin-top: 28px;
  }

  /* ---------- Os cartões ---------- */

  .how__cards {
    margin-top: 48px;
    padding-bottom: 8px;
  }

  .how__card {
    --top: calc(var(--header-h) + 16px + var(--i) * 10px);
    position: sticky;
    top: var(--top);
    display: grid;
    gap: 20px;
    margin-bottom: 18px;
    padding: 26px 22px 28px;
    border: 1px solid rgb(8 43 39 / 0.07);
    border-radius: var(--r-l);
    background: var(--c-shell);
    box-shadow:
      0 -1px 0 rgb(255 255 255 / 0.6) inset,
      0 18px 40px -28px rgb(34 31 27 / 0.32);
  }

  .how__card:last-child {
    margin-bottom: 0;
  }

  .how__card-text > * + * {
    margin-top: 10px;
  }

  .how__num {
    margin-bottom: 18px;
    font-size: 2.75rem;
  }

  .how__card-text p {
    max-width: 46ch;
    color: var(--fg-soft);
  }

  .how__card-text .how__closing {
    color: var(--c-brand);
    font-weight: 500;
  }

  .how :global(.how__photo) {
    border-radius: var(--r-m);
    clip-path: inset(0 round var(--r-m));
  }

  @media (min-width: 768px) {
    .how__card {
      padding: 32px 32px 34px;
    }

    .how__card--photo {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      gap: 32px;
    }
  }

  /* ---------- Desktop: título preso à esquerda, cartões à direita ---------- */

  @media (min-width: 1024px) {
    .how {
      padding-block: 160px 176px;
    }

    .how__head {
      grid-column: col 1 / span 4;
      grid-row: 1;
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + 48px);
    }

    .how__cards {
      grid-column: col 6 / span 7;
      grid-row: 1;
      margin-top: 0;
    }

    .how__card {
      --top: calc(var(--header-h) + 40px + var(--i) * 14px);
      min-height: 300px;
      align-content: start;
      margin-bottom: 28px;
      padding: 40px 44px 44px;
    }

    .how__num {
      font-size: 3.5rem;
    }
  }
</style>
