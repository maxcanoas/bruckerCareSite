---
import logoVertical from "../assets/brand/logo-vertical-light.svg?url";
import { company } from "../data/empresa";
import { footerNav } from "../data/navegacao";
import { whatsappMessages, whatsappUrl } from "../lib/whatsapp";

interface Props {
  /** Mostra "Preferências de cookies" quando o aviso de cookies existe. */
  cookiePreferences?: boolean;
}

const { cookiePreferences = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer tone-dark" data-float-hide>
  <div class="grid site-footer__grid">
    <span class="site-footer__rule" aria-hidden="true"></span>
    <div class="site-footer__brand">
      <img src={logoVertical} width="168" height="87" alt="BruckerCare" loading="lazy" decoding="async" />
      <p class="site-footer__tagline">Cuidado que começa antes mesmo da recuperação.</p>
    </div>

    <nav class="site-footer__col" aria-labelledby="rodape-navegacao">
      <h2 class="label" id="rodape-navegacao">navegação</h2>
      <ul class="site-footer__list">
        {footerNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-footer__col">
      <h2 class="label">contato</h2>
      <ul class="site-footer__list">
        <li>
          <a href={whatsappUrl(whatsappMessages.footer)} target="_blank" rel="noopener" data-track="whatsapp" data-placement="footer">
            WhatsApp {company.whatsapp.display}<span class="sr-only"> (abre em nova aba)</span>
          </a>
        </li>
        <li><a href={company.phone.href} data-track="phone">Telefone {company.phone.display}</a></li>
        <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
        <li>
          <a href={company.instagram.url} target="_blank" rel="noopener" data-track="instagram">
            Instagram {company.instagram.handle}<span class="sr-only"> (abre em nova aba)</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="label">atendimento</h2>
      <p>Entrega e retirada em casa em {company.serviceArea}.</p>
      <p class="site-footer__soft">{company.hours}</p>
    </div>

    <div class="site-footer__legal">
      <a href="/politica-de-privacidade">Política de privacidade</a>
      {cookiePreferences && <button class="site-footer__cookies" type="button" data-consent-open>Preferências de cookies</button>}
      <p>{company.legalName} · {company.taxId}</p>
      <p>© {year} {company.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: 0 112px;
    font-size: 0.9375rem;
  }

  .site-footer__grid {
    row-gap: 40px;
  }

  /* O fio do alto, só na largura do conteúdo, separa o rodapé do fechamento. */
  .site-footer__rule {
    grid-column: content;
    margin-bottom: 32px;
    border-top: 1px solid var(--line-dark);
  }

  /* Depois de uma página que termina no claro, o rodapé começa como as seções:
     cantos macios e sem o fio do alto. */
  :global(main:has(> :last-child:not(.tone-dark))) + .site-footer {
    border-radius: var(--r-sheet) var(--r-sheet) 0 0;
  }

  :global(main:has(> :last-child:not(.tone-dark))) + .site-footer .site-footer__rule {
    border-top-color: transparent;
  }

  .site-footer__brand img {
    width: 140px;
    height: auto;
  }

  .site-footer__tagline {
    max-width: 24ch;
    margin-top: 22px;
    color: var(--c-mist);
  }

  .site-footer__col .label {
    margin-bottom: 16px;
  }

  .site-footer__col p {
    max-width: 30ch;
  }

  .site-footer__list {
    display: grid;
    gap: 4px;
  }

  .site-footer a {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color var(--t-fast) var(--ease);
  }

  .site-footer a:hover {
    text-decoration-color: currentColor;
  }

  .site-footer__list a {
    display: inline-block;
    padding-block: 5px;
  }

  .site-footer__soft {
    margin-top: 8px;
    color: var(--c-mist);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    padding-top: 28px;
    border-top: 1px solid var(--line-dark);
    color: var(--c-mist);
    font-size: var(--fs-small);
  }

  .site-footer__legal a,
  .site-footer__cookies {
    color: var(--c-cream);
  }

  .site-footer__cookies {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-decoration: underline 1px transparent;
    text-underline-offset: 5px;
    cursor: pointer;
    transition: text-decoration-color var(--t-fast) var(--ease);
  }

  .site-footer__cookies:hover {
    text-decoration-color: currentColor;
  }

  @media (min-width: 768px) {
    .site-footer__brand { grid-column: col 1 / span 8; }
    .site-footer__col { grid-column: span 3; }
    .site-footer__col:first-of-type { grid-column: col 1 / span 2; }
    .site-footer__legal { grid-column: content; }
  }

  @media (min-width: 1024px) {
    .site-footer {
      padding-bottom: 56px;
    }

    .site-footer__brand { grid-column: col 1 / span 4; }
    .site-footer__col { grid-column: span 3; }
    .site-footer__col:first-of-type { grid-column: col 5 / span 2; }
    .site-footer__legal { margin-top: 40px; }
    .site-footer__rule { margin-bottom: 48px; }
  }
</style>
