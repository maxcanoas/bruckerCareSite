---
// Lista de perguntas em <details>: abre e fecha sem JavaScript.
// `group` faz as perguntas do mesmo grupo funcionarem como sanfona (uma aberta por vez).
import type { Question } from "../data/perguntas";

interface Props {
  questions: Question[];
  group: string;
  /** Com id em cada pergunta, para link direto (página de perguntas frequentes). */
  anchors?: boolean;
}

const { questions, group, anchors = false } = Astro.props;
---

<div class="faq-items">
  {
    questions.map((q) => (
      <details class="faq-item" name={group} id={anchors ? q.id : undefined}>
        <summary class="faq-item__question">
          <span>{q.question}</span>
          <span class="faq-item__sign" aria-hidden="true" />
        </summary>
        <div class="faq-item__answer prose">
          {q.answer.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq-items {
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
  }

  .faq-item__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 22px;
    color: var(--heading);
    font-size: 1.125rem;
    font-weight: 450;
    line-height: 1.35;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
    transition: color var(--t-fast) var(--ease);
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__question:hover {
    color: var(--accent);
  }

  /* +/− em traço fino dentro de um anel */
  .faq-item__sign {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      border-color var(--t-fast) var(--ease),
      background-color var(--t-fast) var(--ease);
  }

  .faq-item__sign::before,
  .faq-item__sign::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1.5px;
    margin: -0.75px 0 0 -6px;
    background: currentColor;
    transition: rotate var(--t-mid) var(--ease);
  }

  .faq-item__sign::after {
    rotate: 90deg;
  }

  .faq-item__question:hover .faq-item__sign {
    border-color: currentColor;
  }

  .faq-item[open] .faq-item__sign::after {
    rotate: 0deg;
  }

  .faq-item__answer {
    padding: 0 56px 26px 0;
    color: var(--fg-soft);
  }

  /* Abre com transição de altura onde o navegador permite. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) {
      .faq-item {
        interpolate-size: allow-keywords;
      }

      .faq-item::details-content {
        block-size: 0;
        overflow: hidden;
        transition:
          block-size var(--t-mid) var(--ease),
          content-visibility var(--t-mid) allow-discrete;
      }

      .faq-item[open]::details-content {
        block-size: auto;
      }
    }
  }
</style>
